{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend service scaffolded with Express, TypeScript, and Drizzle ORM for PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/workers/jobWorker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
